# Python & Testing artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Large Model weights (keep directory structure with .gitkeep)
models/trained/*
!models/trained/.gitkeep
models/artifacts/*
!models/artifacts/.gitkeep
*.pt
*.pth
*.onnx
*.joblib
*.pkl
*.bin

# Datasets (keep directory structure with .gitkeep)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
*.csv
# Canonical user-supplied dataset is tracked, never regenerated (Phase 2).
!data/iot_sensor_data.csv
*.parquet
*.jsonl
*.h5
*.zip
*.tar.gz

# Temporary isolated dependencies used for asset verification.
.verification-deps/
.verification-runtime/
.verification-runner.mjs
# Preserve the verified existing classifier in clean checkouts.
!models/trained/iot_sensor_model.joblib

# Local Environment Variables & Secrets
.env
.env.local
*.log

