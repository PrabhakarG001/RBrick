# Environment template (no real credentials).
# Copy to .env only if you need to override the defaults.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8088
API_UPSTREAM=http://backend:5000
# Atlas Drivers URI; fill only in your local ignored .env. URL-encode credentials.
MONGODB_URI=
DB_NAME=building_safety
# Atlas TLS stays enabled; only the explicit local Compose override disables it.
MONGODB_TLS=true
# Generate a random value with at least 32 characters locally.
IOT_API_TOKEN=

# --- MQTT broker shipped in this compose file (mqtt/mosquitto.conf) ---
# Loopback-only by default. A physical ESP32 needs MQTT_BIND_IP=0.0.0.0 (or
# this machine's LAN IP) and must connect to <LAN IPv4>:MQTT_PORT. Never
# expose 1883 to the public internet.
MQTT_BIND_IP=127.0.0.1
MQTT_PORT=1883
# Backend ingestion is off until you opt in; set true to run the pipeline.
MQTT_ENABLED=false
# Service name inside compose; use mqtt://127.0.0.1:1883 for a host process.
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=resiliox-backend-subscriber
# Empty = both building/{zone}/{device}/... and legacy building-qualified topics.
# Override with one topic or a comma-separated list when needed.
MQTT_TOPIC=
# rbrick-v1 = nested schema used by IoT firmware and simulator (default).
# flat = legacy env-configured flat contract (fields/rules below).
MQTT_PAYLOAD_FORMAT=rbrick-v1
# For LAN devices use mqtt/compose.auth.yml and mqtt/Initialize-MqttAuth.ps1.
# Load ignored mqtt/.secrets/backend.env after .env; never commit credentials.

# --- Legacy flat payload contract (only used when MQTT_PAYLOAD_FORMAT=flat) ---
DEVICE_ID_FIELD=deviceId
EVENT_ID_FIELD=eventId
TIMESTAMP_FIELD=timestamp
SENSOR_FIELDS_JSON='{}'
ALERT_RULES_JSON='[]'

# Semantic display names -> existing firmware fields. Empty means unconfigured.
SENSOR_DISPLAY_JSON={}
# Freshness assumption, not a hardware heartbeat guarantee.
DEVICE_OFFLINE_AFTER_SECONDS=120

# --- Risk engine (ai-ml rules-v1) ---
# Empty {} uses documented DEMO default thresholds (see backend/src/services/
# riskEngine.js and README). Override per site after validating real sensors.
RISK_THRESHOLDS_JSON={}
# Risk inference runs in Python/FastAPI; never substitute a JS fallback.
# Compose uses ai_ml:8000; host backend uses http://127.0.0.1:8000.
AI_SERVICE_URL=http://ai_ml:8000
AI_TIMEOUT_MS=3000
AI_SERVICE_TOKEN=
# Socket.IO realtime: comma-separated allowed browser origins.
# Empty (default) = same-origin only. Dev with Vite: http://localhost:5173
SOCKET_CORS_ORIGIN=
# ESP32-CAM snapshot endpoints, e.g. {"esp32_cam_01":"http://192.168.1.20:81/snapshot"}.
# Snapshots stay off the MQTT telemetry path and are proxied with API auth.
CAMERA_SNAPSHOT_URLS_JSON={}
CAMERA_SOURCES_JSON={}
# Optional server-to-camera bearer credentials; never expose in VITE_ variables.
CAMERA_BEARER_TOKENS_JSON={}
