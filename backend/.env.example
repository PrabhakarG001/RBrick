PORT=5000
NODE_ENV=development
MONGODB_URI=
DB_NAME=building_safety
MONGODB_TLS=true
# Generate locally; never paste into chat or VITE_ variables.
IOT_API_TOKEN=
MQTT_ENABLED=false
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=resiliox-atlas-ingestor
MQTT_TOPIC=
# Firmware uses the existing nested v1 schema; flat remains opt-in.
MQTT_PAYLOAD_FORMAT=resilliox-v1
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=3000
AI_SERVICE_TOKEN=
# Flat payload key names. Configure these to match the firmware, not vice versa.
DEVICE_ID_FIELD=deviceId
EVENT_ID_FIELD=eventId
TIMESTAMP_FIELD=timestamp
SENSOR_FIELDS_JSON={}
ALERT_RULES_JSON=[]

# Semantic display names -> existing firmware fields. Empty means unconfigured.
SENSOR_DISPLAY_JSON={}
# Freshness assumption, not a hardware heartbeat guarantee.
DEVICE_OFFLINE_AFTER_SECONDS=120
CAMERA_SNAPSHOT_URLS_JSON={}
CAMERA_SOURCES_JSON={}
CAMERA_BEARER_TOKENS_JSON={}
